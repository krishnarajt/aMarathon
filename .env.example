# Database Configuration
DATABASE_URL=postgresql://amarathon:amarathon@localhost:5432/amarathon
# The app runs `alembic upgrade head` itself on startup. Set to false only to
# fall back to create_all(), which builds the schema but records no revision.
USE_ALEMBIC_MIGRATIONS=true

# Authentication
# Generate with: openssl rand -hex 32
SECRET_KEY=your-super-secret-key-change-in-production-use-openssl-rand-hex-32
GATEWAY_SHARED_SECRET=use-the-same-openssl-rand-hex-32-value-as-api-get-away

# MinIO/S3 Configuration (proof screenshots + avatars)
MINIO_ENDPOINT=http://your-minio-endpoint:9000
MINIO_ACCESS_KEY=your-access-key
MINIO_SECRET_KEY=your-secret-key
MINIO_BUCKET=amarathon
MINIO_REGION=us-east-1

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://amarathon.vercel.app

# Logging
LOG_LEVEL=INFO

# Server Configuration
PORT=8000
RELOAD=false
